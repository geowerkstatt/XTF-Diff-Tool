INTERLIS 2.4;

MODEL ObjectAnalyzerTest AT "mailto:noreply@localhost" VERSION "2026-01-22" =
    TOPIC Topic =
        STRUCTURE Struct =
            text : TEXT;
            text2 : TEXT;
        END Struct;

        CLASS Class =
            OID AS INTERLIS.STANDARDOID;

            text : TEXT;
            text2 : TEXT;
            textList : LIST OF TEXT;
            textBag : BAG OF TEXT;
            struct : Struct;
            structList : LIST OF Struct;
        END Class;

        CLASS ClassWithoutId =
            text : TEXT;
            text2 : TEXT;
            textList : LIST OF TEXT;
            textBag : BAG OF TEXT;
        END ClassWithoutId;
    END Topic;
END ObjectAnalyzerTest.
