INTERLIS 2.4;

MODEL ObjectAnalyzerTest AT "mailto:noreply@localhost" VERSION "2026-01-22" =
    TOPIC Topic =
        STRUCTURE Struct =
            text : TEXT;
            text2 : TEXT;
        END Struct;

        CLASS Class =
            OID AS INTERLIS.STANDARDOID;

            text : TEXT;
            text2 : TEXT;
            textList : LIST OF TEXT;
            textBag : BAG OF TEXT;
            struct : Struct;
            structList : LIST OF Struct;
        END Class;

        CLASS ClassWithoutId =
            text : TEXT;
            text2 : TEXT;
            textList : LIST OF TEXT;
            textBag : BAG OF TEXT;
        END ClassWithoutId;

        CLASS ClassB =
            OID AS INTERLIS.STANDARDOID;
        END ClassB;

        ASSOCIATION EmbeddedAssociation =
            role1A -- {1} Class;
            role1B -- ClassB;

            value : TEXT;
        END EmbeddedAssociation;
    END Topic;
END ObjectAnalyzerTest.
