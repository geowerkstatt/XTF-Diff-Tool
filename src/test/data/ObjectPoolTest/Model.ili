INTERLIS 2.4;

MODEL Model AT "mailto:noreply@localhost" VERSION "2026-01-22" =
    TOPIC TopicMissingOid =
        CLASS ClassMissingOid =
        END ClassMissingOid;

        CLASS ClassNoOid =
            NO OID;
        END ClassNoOid;

        CLASS ClassOid =
            OID AS INTERLIS.UUIDOID;
        END ClassOid;

        ASSOCIATION AssocOid =
            OID AS INTERLIS.UUIDOID;
            role1 -- ClassOid;
            role2 -<> ClassNoOid;
        END AssocOid;
    END TopicMissingOid;

    TOPIC TopicOid =
        OID AS INTERLIS.UUIDOID;

        CLASS ClassMissingOid =
        END ClassMissingOid;

        CLASS ClassNoOid =
            NO OID;
        END ClassNoOid;

        CLASS ClassOid =
            OID AS INTERLIS.UUIDOID;
        END ClassOid;

        ASSOCIATION AssocMissingOid =
            role1 -- ClassOid;
            role2 -<> ClassNoOid;
        END AssocMissingOid;
    END TopicOid;

    TOPIC TopicOidExtended EXTENDS TopicOid =
        CLASS ClassMissingOidExtended EXTENDS ClassMissingOid =
        END ClassMissingOidExtended;

        CLASS ClassNoOidExtended EXTENDS ClassNoOid =
        END ClassNoOidExtended;

        CLASS ClassOidExtended EXTENDS ClassOid =
        END ClassOidExtended;
    END TopicOidExtended;

    TOPIC TopicAssociations =
        OID AS INTERLIS.STANDARDOID;

        CLASS Main =
        END Main;

        CLASS A = END A;
        CLASS B = END B;
        CLASS C = END C;
        CLASS D = END D;
        CLASS E = END E;
        CLASS F = NO OID; END F;
        CLASS G = END G;

        ASSOCIATION Embedded =
            RoleMain -- {0..1} Main;
            RoleA -- {0..*} A;
        END Embedded;

        ASSOCIATION EmbeddedWithAttribute =
            RoleMain -- {0..1} Main;
            RoleB -- {0..*} B;
            Attr: TEXT*20;
        END EmbeddedWithAttribute;

        ASSOCIATION Standalone =
            RoleMain -- {0..1} Main;
            RoleC -- {0..*} C;
            RoleD -- {0..*} D;
        END Standalone;

        ASSOCIATION StandaloneWithOid (OID) =
            RoleMain -- {0..1} Main;
            RoleE -- {0..*} E;
        END StandaloneWithOid;

        ASSOCIATION StandaloneWithRoleToUnstableId (OID) =
            RoleMain -- {0..1} Main;
            RoleF -- {0..*} F;
            RoleG -- {0..*} G;
        END StandaloneWithRoleToUnstableId;

    END TopicAssociations;
END Model.
